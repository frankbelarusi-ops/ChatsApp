<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF111111">

    <ProgressBar
        android:id="@+id/progressBarStory"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/colorAccent" />

    <LinearLayout
        android:id="@+id/layoutStoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_below="@+id/progressBarStory"
        android:layout_marginTop="10dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/circleImageViewStoryAuthor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_person" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">

            <TextView
                android:id="@+id/textViewStoryAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autor"
                android:textColor="@color/colorWhite"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewStoryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace un momento"
                android:textColor="@color/colorGray"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imageViewCloseStory"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_clear"
            android:tint="@color/colorWhite"
            android:padding="4dp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imageViewStoryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layoutStoryHeader"
        android:layout_above="@+id/textViewStoryCaption"
        android:scaleType="fitCenter"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/textViewStoryCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#88000000"
        android:textColor="@color/colorWhite"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

</RelativeLayout>
